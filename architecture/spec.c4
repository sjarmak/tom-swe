// Element kinds, tags, and custom colors for the `tom-swe` architecture model.
//
// Tags encode delivery state so planned / unwired work is visually distinct
// from what is already built and exercised at runtime:
//   #built     — code path exists and runs in the live hook/skill pipeline
//   #evolving  — built and running, but the contract/behavior is still moving
//   #planned   — designed, code exists, but not yet wired into the runtime path
//   #research  — speculative track (paper-derived, not implemented)

specification {

  element actor {
    style {
      shape person
      color secondary
    }
  }

  element externalSystem {
    style {
      shape rectangle
      color slate
    }
  }

  element system

  element container {
    style {
      shape rectangle
    }
  }

  element component

  element datastore {
    style {
      shape cylinder
    }
  }

  // Deployment model — where each piece runs at review time.
  deploymentNode host {
    style {
      shape rectangle
      color slate
    }
  }
  deploymentNode proc

  tag built {
    color #16a34a
  }
  tag evolving {
    color #d97706
  }
  tag planned {
    color #64748b
  }
  tag research {
    color #6366f1
  }

  // Cross-cutting: carried by any element that is a known risk / open question
  // for the design review (in addition to its delivery-state tag).
  tag risk {
    color #dc2626
  }
}
